FROM node:20-alpine AS development

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY vite.config.ts tsconfig.json tsconfig.node.json ./
COPY postcss.config.js tailwind.config.js ./
COPY index.html ./
COPY src ./src
COPY public ./public

ENV VITE_API_URL=http://localhost:3000

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host"]