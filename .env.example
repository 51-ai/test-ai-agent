# ========================================
# AI Agent System - Environment Variables
# ========================================
# Copy this file to .env and update the values

# ----------------------------------------
# Server Configuration
# ----------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ----------------------------------------
# Database Configuration
# ----------------------------------------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_URI=mongodb://admin:admin123@mongodb:27017/ai-agent?authSource=admin

# ----------------------------------------
# Redis Configuration
# ----------------------------------------
REDIS_URI=redis://redis:6379

# ----------------------------------------
# Authentication Configuration
# ----------------------------------------
JWT_SECRET=your-secret-key-change-in-production-min-32-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ----------------------------------------
# OpenAI Configuration
# ----------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ----------------------------------------
# Rate Limiting Configuration
# ----------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------
# Frontend Configuration
# ----------------------------------------
VITE_API_URL=http://localhost:3000

# ----------------------------------------
# Logging Configuration
# ----------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# ----------------------------------------
# Performance Configuration
# ----------------------------------------
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT_MS=30000
MEMORY_SHORT_TERM_TTL=3600
MEMORY_LONG_TERM_TTL=2592000