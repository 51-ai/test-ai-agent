# ============================================
# AI Agent - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values

# ----------------------------------------
# Server Configuration
# ----------------------------------------
PORT=3000
HOST=localhost
NODE_ENV=development

# ----------------------------------------
# Security Configuration
# ----------------------------------------
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# 旧版本 BCRYPT_ROUNDS=10，新版本=12
# 平滑迁移机制：用户下次登录 comparePassword 成功时
# 会自动用新 rounds=12 重 hash passwordHash 并 save()
# （回滚开关：需降级时改回 10，新用户即走 rounds=10）

# ----------------------------------------
# Database Configuration
# ----------------------------------------
MONGO_URI=mongodb://localhost:27017/ai-agent
REDIS_URI=redis://localhost:6379

# ----------------------------------------
# LLM Configuration
# ----------------------------------------
# DeepSeek API Key (required)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Available models:
# - deepseek-v4-pro: 旗舰推理模型 (¥3/百万输入, ¥6/百万输出)
# - deepseek-v4-flash: 经济快速模型 (¥1/百万输入, ¥2/百万输出)
LLM_MODEL=deepseek-v4-pro
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# ----------------------------------------
# 文档照片识别（手机拍摄的文档照片 → 文本）
# ----------------------------------------
# 复用 OpenAI 兼容的视觉模型接口；未配置 Key 时照片识别会明确报错并提示配置，
# 不会静默返回空文本。默认取 OPENAI_API_KEY / OPENAI_API_BASE。
# OCR_VISION_API_KEY=your-vision-api-key-here
# OCR_VISION_API_BASE=https://api.openai.com/v1
OCR_VISION_MODEL=gpt-4o-mini
OCR_VISION_TIMEOUT_MS=60000
# 单张照片体积上限（字节），默认 10MB
OCR_MAX_IMAGE_BYTES=10485760

# ----------------------------------------
# Alternative LLM Providers (Optional)
# ----------------------------------------
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# Claude 3
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Qwen
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen-max
QWEN_API_BASE=https://api.together.xyz/v1

# ----------------------------------------
# Search Engine Configuration
# ----------------------------------------
# Google Search (requires API Key and CX)
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_CX=your-google-custom-search-cx

# Bing Search (requires API Key)
BING_SEARCH_API_KEY=your-bing-search-api-key

# DuckDuckGo (free, no API Key required)
USE_DUCKDUCKGO=true

# ----------------------------------------
# Security Hardening Rollout Switches (秒级回滚开关)
# ----------------------------------------
# bcrypt rounds (默认 12，可改回 10 回滚)
BCRYPT_ROUNDS=12
# MFA 双因素认证总开关 (=1 关闭 MFA，所有用户都不再要求二次验证)
MFA_DISABLED=0
# LLM I/O Guard (=off 关闭中间件)
I_O_GUARD=1

# ----------------------------------------
# Developer Mode Configuration
# ----------------------------------------
DEVELOPER_MODE=true
DEVELOPER_API_KEY=dev-key-2024-secure-token
DEVELOPER_USER_ID=dev-user-001
DEVELOPER_MAX_REQUESTS=60
DEVELOPER_LOGGING=true
DEVELOPER_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
# ---------- RAG 向量化（真实语义向量） ----------
# local=本地模型（无需密钥，需 npm i @huggingface/transformers）| api=OpenAI 兼容 /embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_LOCAL=Xenova/bge-small-zh-v1.5
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CACHE_DIR=./data/models
# 国内下载模型可启用镜像
HF_ENDPOINT=https://hf-mirror.com
# RAG 向量索引落盘路径（不设置则仅存内存）
RAG_INDEX_PATH=./data/rag-index.json
