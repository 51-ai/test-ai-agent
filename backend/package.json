{
  "name": "ai-agent-backend",
  "version": "1.0.0",
  "description": "High-performance AI Agent System Backend",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc && node -e \"require('fs').cpSync('public','dist/public',{recursive:true})\"",
    "dev": "nodemon src/index.ts",
    "test": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "verify:rag": "ts-node --transpile-only scripts/verify-rag-embedding.ts",
    "guard": "node scripts/guard.mjs",
    "verify": "npm run typecheck && npm run guard && jest --testPathIgnorePatterns competitive-analysis-real"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@huggingface/transformers": "^4.3.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.2.0",
    "jszip": "^3.10.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mongodb-memory-server": "^11.2.0",
    "pdf-parse": "^1.1.1",
    "mongoose": "^8.24.1",
    "openai": "^4.68.1",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^5.0.4",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.2",
    "vm2": "^3.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.7.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/socket.io": "^3.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
